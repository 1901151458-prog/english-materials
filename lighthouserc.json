{
  "ci": {
    "collect": {
      "url": [
        "https://1901151458-prog.github.io/english-materials/",
        "https://1901151458-prog.github.io/english-materials/g7a/unit1-reading/",
        "https://1901151458-prog.github.io/english-materials/g7a-nouns/",
        "https://1901151458-prog.github.io/english-materials/vocab-5-books/",
        "https://1901151458-prog.github.io/english-materials/typing/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu --disable-dev-shm-usage",
        "skipAudits": [
          "canonical",
          "is-crawlable",
          "robots-txt",
          "tap-targets",
          "valid-source-maps",
          "unused-javascript"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.70 }],
        "categories:accessibility": ["warn", { "minScore": 0.75 }],
        "categories:best-practices": ["warn", { "minScore": 0.75 }],
        "categories:seo": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse"
    }
  }
}
